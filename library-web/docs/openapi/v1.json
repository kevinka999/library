{
  "openapi": "3.1.1",
  "info": {
    "title": "Library.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5168/"
    }
  ],
  "paths": {
    "/api/books/{id}": {
      "put": {
        "tags": [
          "UpdateBook"
        ],
        "summary": "Replaces every editable field of a Book using optimistic concurrency.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The database-generated Book identifier.",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "description": "The current strong Book ETag, for example \"1\".",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "The complete replacement state for every editable Book field.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateBookInputDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateBookInputDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateBookInputDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Returns the current Book and ETag after an update or no-op.",
            "headers": {
              "ETag": {
                "description": "The strong ETag representing the current Book version.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateBookOutputDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateBookOutputDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateBookOutputDto"
                }
              }
            }
          },
          "400": {
            "description": "The request body or If-Match value is invalid.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "The requested Book does not exist.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "412": {
            "description": "The supplied ETag is stale.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "428": {
            "description": "The If-Match header is absent.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "GetBook"
        ],
        "summary": "Retrieves the complete current representation of a Book.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the current Book with its ETag.",
            "headers": {
              "ETag": {
                "description": "The strong ETag representing the current Book version.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/GetBookOutputDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetBookOutputDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetBookOutputDto"
                }
              }
            }
          },
          "404": {
            "description": "The requested Book does not exist.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/books": {
      "get": {
        "tags": [
          "SearchBooks"
        ],
        "summary": "Returns a deterministic numbered page of Books.",
        "description": "Search is case-insensitive across title, short description, and every\nAuthor Name. Results are always ordered by title and then Book ID.",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "description": "Optional case-insensitive text matched literally within title, short description, or any Author Name.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "One-based page number. Defaults to 1.",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Books per page, from 1 through 100. Defaults to 20.",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the requested page and collection totals.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/SearchBooksOutputDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchBooksOutputDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchBooksOutputDto"
                }
              }
            }
          },
          "400": {
            "description": "A paging value or query parameter is invalid.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "CreateBook"
        ],
        "summary": "Creates a Book and its complete initial Change Set.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBookInputDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBookInputDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBookInputDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Returns the normalized Book with Location and ETag headers.",
            "headers": {
              "ETag": {
                "description": "The strong ETag representing the current Book version.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/CreateBookOutputDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateBookOutputDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateBookOutputDto"
                }
              }
            }
          },
          "400": {
            "description": "Returns all detected validation errors.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/books/{id}/history": {
      "get": {
        "tags": [
          "GetBookHistory"
        ],
        "summary": "Returns cursor-paged complete Change Sets for a Book.",
        "description": "Cursors are opaque and may only be reused with the same normalized\nChanged Field, time, and sort filters. A Changed Field match includes\nevery change in its containing Change Set.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "changedField",
            "in": "query",
            "description": "Optional repeatable filter: title, shortDescription, publishDate, or authors. Repeated values use any-match semantics.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "changedFrom",
            "in": "query",
            "description": "Optional inclusive lower UTC instant.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "changedBefore",
            "in": "query",
            "description": "Optional exclusive upper UTC instant.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "sortDirection",
            "in": "query",
            "description": "Chronological direction: ascending or descending. Defaults to descending.",
            "schema": {
              "type": "string",
              "default": "descending"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Complete Change Sets per page, from 1 through 100. Defaults to 20.",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 20
            }
          },
          {
            "name": "after",
            "in": "query",
            "description": "Opaque cursor returned as nextCursor by a compatible prior request.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns at most the requested number of complete Change Sets.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/GetBookHistoryOutputDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetBookHistoryOutputDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetBookHistoryOutputDto"
                }
              }
            }
          },
          "400": {
            "description": "A filter, query parameter, time range, or cursor is invalid.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "The requested Book does not exist.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
